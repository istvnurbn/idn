# NOTE: fileSystems for /, /nix, /boot, and /persist are generated by disko
# from the mountpoints in disko.nix, so they are not declared here.
# Check den.aspects.disko-btrfs-impermanence-main to get an idea.
{
  den,
  inputs,
  lib,
  ...
}: let
  # One aspect's `persist` or `persistHome` value: an attribute set with only
  # `directories` and `files` lists, so a misspelled name or a plain list
  # stops evaluation. Not a submodule, which reads "/etc/lact" as a module path.
  entry =
    lib.types.addCheck (lib.types.attrsOf (lib.types.listOf lib.types.anything))
    (e: lib.subtractLists ["directories" "files"] (lib.attrNames e) == [])
    // {description = "attribute set of `directories` and `files` lists";};

  # A quirk's value is a list with one entry per aspect that set it
  merge = entries: {
    hideMounts = true;
    directories = lib.unique (lib.concatMap (e: e.directories or []) entries);
    files = lib.unique (lib.concatMap (e: e.files or []) entries);
  };
in {
  flake-file.inputs.impermanence = {
    url = "github:nix-community/impermanence";
    inputs.nixpkgs.follows = "";
    inputs.home-manager.follows = "";
  };

  # Aspects list what they keep: `persist` for system paths, `persistHome`
  # for paths relative to the user's home. Hosts without impermanence
  # have no collector, so the lists are simply unused there.
  den.quirks.persist.description = "System paths kept on /persist";
  den.quirks.persistHome.description = "Home paths kept on /persist";

  # Hands every aspect's lists to the impermanence module. The values pass
  # through a typed option first, so the module system checks each entry.
  den.aspects.impermanence.collect = {
    nixos = {
      config,
      persist,
      ...
    }: {
      options.impermanence.persist = lib.mkOption {
        type = lib.types.listOf entry;
        internal = true;
      };
      config = {
        impermanence.persist = persist;
        environment.persistence."/persist" = merge config.impermanence.persist;
      };
    };
    homeManager = {
      config,
      persistHome,
      ...
    }: {
      options.impermanence.persistHome = lib.mkOption {
        type = lib.types.listOf entry;
        internal = true;
      };
      config = {
        impermanence.persistHome = persistHome;
        home.persistence."/persist" = merge config.impermanence.persistHome;
      };
    };
  };

  den.aspects.impermanence = {
    # Without the collector the root would be wiped and nothing persisted
    includes = [den.aspects.impermanence.collect];

    nixos = {
      config,
      lib,
      utils,
      ...
    }: let
      root = config.fileSystems."/";
      rootDevice = "${utils.escapeSystemdPath root.device}.device";
      onRootSubvol = lib.elem "subvol=root" root.options || lib.elem "subvol=/root" root.options;
    in {
      imports = [inputs.impermanence.nixosModules.impermanence];

      # The wipe below recreates the `root` btrfs subvolume, so / has to be it
      assertions = [
        {
          assertion = root.fsType == "btrfs" && onRootSubvol;
          message = "impermanence: / must be the `root` subvolume of a btrfs disk (see den.aspects.disko-btrfs-impermanence-main)";
        }
      ];

      # Wipe root subvolume on boot, keeping old snapshots for 30 days
      boot.initrd.systemd = {
        enable = true; # Default in 26.05
        services.wipe-file-systems = {
          # Specify dependencies explicitly
          unitConfig.DefaultDependencies = false;
          # The script needs to run to completion before this service is done
          serviceConfig.Type = "oneshot";
          # This service is required for boot to succeed
          requiredBy = ["initrd.target"];
          # Should complete before any file systems are mounted
          before = ["sysroot.mount"];

          # Wait for the disk / lives on to appear
          requires = [rootDevice];
          after = [
            rootDevice
            # Allow hibernation to resume before trying to alter any data
            "local-fs-pre.target"
          ];

          script = ''
            set -euo pipefail

            mkdir /btrfs_tmp
            # subvolid=5 is the top level, even if the default subvolume was changed
            mount -o subvolid=5 ${lib.escapeShellArg root.device} /btrfs_tmp
            mkdir -p /btrfs_tmp/old_roots

            if [[ -e /btrfs_tmp/root ]]; then
                timestamp=$(date --date="@$(stat -c %Y /btrfs_tmp/root)" "+%Y-%m-%d_%H:%M:%S")
                mv -T /btrfs_tmp/root "/btrfs_tmp/old_roots/$timestamp"
            fi

            # Pruning old snapshots is best-effort: a single failed deletion
            # must not block the new root from being created and boot from
            # succeeding.
            for i in $(find /btrfs_tmp/old_roots/ -mindepth 1 -maxdepth 1 -mtime +30); do
                btrfs subvolume delete --recursive "$i" || echo "warning: failed to delete $i" >&2
            done

            btrfs subvolume create /btrfs_tmp/root
            umount /btrfs_tmp
          '';
        };
      };
    };

    # Default stuff that we want to persist on every impermanent host
    persist = {
      directories = [
        "/var/lib/nixos"
        "/var/lib/systemd/coredump"
        "/var/lib/systemd/timers"
        "/var/log"
      ];
      files = [
        "/etc/machine-id"
      ];
    };

    # XDG user folders are persisted by the aspect that creates them
    # (see steve/xdg-folders.nix); only account-baseline entries live here.
    persistHome = {
      directories = [
        "Projects"
        {
          directory = ".ssh";
          mode = "0700";
        }
      ];
    };
  };
}
