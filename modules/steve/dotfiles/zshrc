# completion: compinit first, so later compdef calls (zoxide's) register.
# -C trusts the dump and skips the rescan and compaudit, about 70 ms a shell.
# The dump is named after the running system (:A resolves the symlink), so
# each switch starts a fresh one and picks up new completions. Quoted, or
# macOS's /bin/zsh 5.9 leaks the '-' as a pattern token (byte 0x9b) and :A fails.
# -i: never stop to ask about insecure dirs while building it.
ZCOMPDUMP=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-${${:-"/run/current-system"}:A:t}
[[ -e $ZCOMPDUMP ]] || { mkdir -p ${ZCOMPDUMP:h} && rm -f ${ZCOMPDUMP:h}/zcompdump*(N) }
autoload -Uz compinit && compinit -C -i -d $ZCOMPDUMP

# prompt: Pure
autoload -Uz promptinit && promptinit && prompt pure

zstyle ':prompt:pure:git:stash' show yes
zstyle ':prompt:pure:custom:prefix' color cyan

# Pure shows nix-shell/nix develop natively (IN_NIX_SHELL); `nix shell` sets
# nothing, so mark it and render [nix shell] through Pure's custom prefix.
nix() {
  [[ $1 == shell ]] && local -x NIX_SHELL_CUE=1
  command nix "$@"
}
[[ -n $NIX_SHELL_CUE ]] && prompt_pure_precustom() { psvar[22]='[nix shell]'; }

# keybindings
bindkey -e                       # zsh picks vi mode if $EDITOR/$VISUAL contains "vi"
bindkey '^A' backward-word       # your remap (default: beginning-of-line)
bindkey '^E' forward-word        # also accepts an autosuggestion word by word
bindkey '^[[1;5D' backward-word  # Ctrl+Left
bindkey '^[[1;5C' forward-word   # Ctrl+Right

# history: zsh's own fallback, not persisted; atuin keeps the real history
HISTFILE=~/.zsh_history
HISTSIZE=5000
SAVEHIST=$HISTSIZE
setopt share_history hist_ignore_space hist_ignore_all_dups hist_save_no_dups hist_find_no_dups

# completion styling
# smart-case prefix match first, then smart-case substring match as fallback
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' 'm:{a-z}={A-Za-z} l:|=* r:|=*'
zstyle ':completion:*' menu no                     # fzf-tab draws the menu
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '[%d]'  # group headers in fzf-tab
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# single quotes: $realpath must expand when fzf-tab runs, not now
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color=always -- "$realpath"'
zstyle ':fzf-tab:*' fzf-bindings 'tab:accept'

# aliases
alias ls='ls -h --group-directories-first --color=auto'
alias mc='mc --nosubshell'
(( $+commands[bat] )) && alias cat='bat --paging=never'

# integrations (keep atuin after fzf: both bind Ctrl+R)
(( $+commands[fzf] ))    && source <(fzf --zsh)
(( $+commands[zoxide] )) && eval "$(zoxide init --cmd cd zsh)"
(( $+commands[atuin] ))  && eval "$(atuin init zsh)"

# plugins, from nixpkgs (modules/system/shell.nix). Last, as zinit's turbo
# mode loaded them, so the widget wrappers see every widget above.
# Order: fzf-tab -> syntax highlighting -> autosuggestions.
# fast-syntax-highlighting downloads this theme from GitHub master when it is
# missing. Only a theme that names a secondary theme reads it, and none is set.
FAST_WORK_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/fsh
[[ -e $FAST_WORK_DIR/secondary_theme.zsh ]] || { mkdir -p $FAST_WORK_DIR && : >$FAST_WORK_DIR/secondary_theme.zsh }
source /run/current-system/sw/share/fzf-tab/fzf-tab.plugin.zsh
source /run/current-system/sw/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
source /run/current-system/sw/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
